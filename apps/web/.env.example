# Server-only OIDC/BFF settings. Do not use NEXT_PUBLIC_ for tokens or secrets.
OULA_BACKEND_URL=https://api.example.invalid
OULA_APP_ORIGIN=https://app.example.invalid
OULA_OIDC_ISSUER=https://identity.example.invalid
OULA_OIDC_CLIENT_ID=oula-web
OULA_OIDC_AUDIENCE=oula-api
OULA_SESSION_SECRET=
# OULA_OIDC_CLIENT_SECRET=configure-only-if-required-by-the-identity-provider
OULA_ALLOW_HTTP_LOCALHOST=false
OULA_LOCAL_DEV_AUTH=false
# For a local, fictional database-backed session use scripts/start-local-expo.sh.
